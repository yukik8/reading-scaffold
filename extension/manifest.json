{
  "manifest_version": 3,
  "name": "reading-scaffold (dev)",
  "version": "0.21.1",
  "description": "Google Play ブックスで読む時間を、補助が自動で減っていく演出で支える読書拡張。計測は「読む」を押した間だけ。",
  "permissions": ["scripting", "storage", "alarms"],
  "host_permissions": [
    "https://play.google.com/books/*",
    "https://books.googleusercontent.com/books/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_page": "src/dashboard/dashboard.html",
  "action": {
    "default_title": "読む",
    "default_popup": "src/popup/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/content/*.js", "src/shared/*.js"],
      "matches": ["https://play.google.com/*", "https://books.googleusercontent.com/*"]
    }
  ]
}
