{
  "manifest_version": 3,
  "name": "reading-scaffold (dev)",
  "version": "0.0.1",
  "description": "補助が自動で減っていく読書拡張。セッション中のみ読書時間を計測する。",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "読む",
    "default_popup": "src/popup/popup.html"
  }
}
